# Copia a .env y completa los valores:
#   cp .env.example .env

# --- X bookmarks (único método soportado por la API en este endpoint) ---
# Token OAuth 2.0 de USUARIO (authorization code + PKCE), con scopes:
#   tweet.read, users.read, bookmark.read
# No uses el Bearer "solo aplicación" del portal. OAuth 1.0a devuelve HTTP 403 en bookmarks.
KNOWLEDGE_COMPILER_X_ACCESS_TOKEN=

# Consumer key/secret sirven para configurar la app y el flujo OAuth 2 en el portal;
# el CLI no los usa para llamar a bookmarks (solo lee el ACCESS_TOKEN de arriba).
# KNOWLEDGE_COMPILER_X_CONSUMER_KEY=
# KNOWLEDGE_COMPILER_X_CONSUMER_SECRET=

# Opcional: raíz del proyecto (contiene workspace/)
# KNOWLEDGE_COMPILER_ROOT=

# --- Optional: LLM-backed `ask --llm` (OpenAI-compatible Chat Completions) ---
# KNOWLEDGE_COMPILER_OPENAI_API_KEY=
# KNOWLEDGE_COMPILER_OPENAI_BASE_URL=https://api.openai.com
# KNOWLEDGE_COMPILER_LLM_MODEL=gpt-4o-mini
